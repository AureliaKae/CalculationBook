{
  "name": "calculationpaper",
  "version": "0.1.0",
  "description": "入书为客，落笔成命——以你读过的小说为世界的互动生存游戏",
  "author": "CalculationPaper Studio",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test && eslint .",
    "simulate": "node scripts/simulate.js",
    "lint": "eslint .",
    "dev": "node scripts/dev.cjs",
    "start": "node scripts/start-electron.cjs",
    "build": "vite build",
    "pack": "vite build && electron-builder --win",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/cossette-texte": "^5.3.0",
    "@fontsource/cossette-titre": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "gsap": "^3.13.0",
    "iconv-lite": "^0.7.0",
    "jszip": "^3.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.0",
    "electron": "43.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "vite": "^7.0.0"
  },
  "build": {
    "appId": "studio.calculationpaper.app",
    "productName": "推演书",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "renderer/dist/**",
      "src/**",
      "fixtures/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "CalculationPaper-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "CalculationPaper-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron@43.4.1": true,
    "esbuild@0.28.2": true
  }
}
